# Copy this file to .env.dev and add keys for the providers you select.
ENVIRONMENT=development
LOG_LEVEL=INFO
AGENT_NAME=yojnapath-web-agent
DEV_SERVER_HOST=127.0.0.1
DEV_SERVER_PORT=8081

# Required backend provider keys for the default voice pipeline.
GROQ_API_KEY=
SARVAM_API_KEY=

# Only required when using `dev`, `connect`, or `start` room modes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Plivo India inbound calling. Use only the subdomain shown by LiveKit, not a URL.
LIVEKIT_SIP_SUBDOMAIN=
PLIVO_PHONE_NUMBER=
SIP_ROOM_PREFIX=call-
# Use tls only after enabling secure trunking in Plivo; tcp is the simplest first test.
SIP_TRANSPORT=tcp

# Optional LiveKit/OpenTelemetry tracing in Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# The settings below use Groq for the LLM and Sarvam for STT/TTS.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# llama.cpp default; keep the dummy key unless your server enables authentication.
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-no-key-required
SARVAM_BASE_URL=https://api.sarvam.ai/v1
# Optional alternatives; not used by the default pipeline.
SMALLEST_AI_API_KEY=
SMALLEST_BASE_URL=https://api.smallest.ai/waves/v1
STT_PROVIDER=sarvam
STT_SARVAM_MODEL=saaras:v4
STT_SARVAM_LANGUAGE=hi-IN
STT_SARVAM_MODE=codemix
STT_GROQ_MODEL=whisper-large-v3-turbo
STT_PULSE_MODEL=pulse
STT_LANGUAGE=hi
STT_DETECT_LANGUAGE=false
STT_SAMPLE_RATE=16000
STT_ENCODING=linear16
STT_WORD_TIMESTAMPS=true
STT_DIARIZE=false
STT_EOU_TIMEOUT_MS=300
STT_ENDPOINTING=true
STT_KEYWORDS=[]
STT_FORMAT=true
STT_SENTENCE_TIMESTAMPS=true
STT_REDACT_PII=false
STT_REDACT_PCI=false
# Pulse emotion detection is currently prerecorded-only and cannot be enabled here.
STT_EMOTION_DETECTION=false
LLM_PROVIDER=groq
# For openai, use the llama-server --alias value (or the model id from GET /v1/models).
LLM_MODEL=qwen/qwen3.8-27b
LLM_REASONING_EFFORT=none
LLM_MAX_COMPLETION_TOKENS=256
TTS_MODEL=bulbul:v3
TTS_LANGUAGE=hi-IN
TTS_SPEAKER=shubh

# Voice activity, end-of-turn, interruption, and echo tuning.
VAD_MIN_SPEECH_DURATION=0.05
VAD_MIN_SILENCE_DURATION=0.55
VAD_PREFIX_PADDING_DURATION=0.5
VAD_ACTIVATION_THRESHOLD=0.5
ENDPOINTING_MIN_DELAY=0.35
ENDPOINTING_MAX_DELAY=2.0
FALSE_INTERRUPTION_TIMEOUT=1.0
AEC_WARMUP_DURATION=3.0
PREEMPTIVE_GENERATION=true
