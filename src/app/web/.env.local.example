# Next.js server-only credentials for private browser calls.
WEB_CALL_ACCESS_ENABLED=false
WEB_CALL_ACCESS_CODE=replace-with-a-long-random-private-code
WEB_CALL_MAX_DURATION_SECONDS=300
WEB_CALL_TOKEN_TTL_SECONDS=120
LIVEKIT_URL=ws://localhost:7880
# Optional server-side route to LiveKit; useful when public signaling uses a separate ingress.
LIVEKIT_INTERNAL_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=yojnapath-web-agent
# Set to your deployed HTTPS origin for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
